# ─── COPY ไฟล์นี้เป็น .env แล้วใส่ค่าจริง ───────────────────────────────────
# อย่า commit ไฟล์ .env ขึ้น GitHub เด็ดขาด!

# 1. Discord Webhook URL (จำเป็น)
#    วิธีได้: Discord Server → Edit Channel → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY

# 2. NewsAPI Key (ฟรี 500 req/วัน — ถ้าไม่มีบอทจะดึงแค่ ForexFactory)
#    สมัครที่: https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# 3. ความถี่ตรวจข่าว (วินาที) — 600 = ทุก 10 นาที
CHECK_INTERVAL_SEC=600

# หมายเหตุ: ไม่ต้องการ Anthropic API key อีกต่อไป
# การแปลภาษาไทยใช้ Google Translate ผ่าน deep-translator (ฟรี 100%)
